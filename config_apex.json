{
    "max_open_trades": 3,
    "stoploss": -0.05,
    "trailing_stop": true,
    "trailing_stop_positive": 0.02,
    "trailing_stop_positive_offset": 0.03,
    "stake_currency": "USDC",
    "stake_amount": 100,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,
    "trading_mode": "futures",
    "margin_mode": "cross",
    "timeframe": "1h",
    "fee": 0.0005,
    "synthetic": true,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "exchange": {
        "name": "apex",
        "pair_whitelist": [
            "BTC/USDC",
            "ETH/USDC"
        ],
        "pair_blacklist": []
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8085,
        "verbosity": "error",
        "CORS_origins": [],
        "username": "freqtrader"
    },
    "bot_name": "cryptobot-apex",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    },
    "add_config_files": [
        "config_apex.secret.json"
    ]
}
